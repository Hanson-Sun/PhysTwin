<mujoco model="sim_object_doll">
  <asset>
    <material name="doll_skin" rgba="0.88 0.48 0.36 1"/>
    <material name="doll_shirt" rgba="0.25 0.42 0.78 1"/>
  </asset>

  <worldbody>
    <body name="object" gravcomp="1">
      <freejoint name="object_joint"/>
      <!-- Metadata/free-joint anchor used by the existing rollout API. -->
      <geom name="object_root" type="sphere" pos="0 0 0.15" size="0.001"
            mass="0.001" contype="0" conaffinity="0"/>

      <!-- Torso: six parallel elastic strands form a connected soft volume. -->
      <flexcomp name="torso_front" type="grid" count="7 1 1" dim="1" pos="0 -0.035 0.10" spacing="0.02 0.02 0.02" radius="0.006" mass="0.025" material="doll_shirt">
        <edge stiffness="8" damping="2"/>
        <contact solref="0.02 1" solimp="0.8 0.95 0.01" condim="3" friction="0.9 0.02 0.01"/>
      </flexcomp>
      <flexcomp name="torso_back" type="grid" count="7 1 1" dim="1" pos="0 0.035 0.10" spacing="0.02 0.02 0.02" radius="0.006" mass="0.025" material="doll_shirt">
        <edge stiffness="8" damping="2"/>
        <contact solref="0.02 1" solimp="0.8 0.95 0.01" condim="3" friction="0.9 0.02 0.01"/>
      </flexcomp>
      <flexcomp name="torso_low" type="grid" count="7 1 1" dim="1" pos="0 0 0.07" spacing="0.02 0.02 0.02" radius="0.006" mass="0.025" material="doll_shirt">
        <edge stiffness="8" damping="2"/>
        <contact solref="0.02 1" solimp="0.8 0.95 0.01" condim="3" friction="0.9 0.02 0.01"/>
      </flexcomp>
      <flexcomp name="torso_high" type="grid" count="7 1 1" dim="1" pos="0 0 0.13" spacing="0.02 0.02 0.02" radius="0.006" mass="0.025" material="doll_shirt">
        <edge stiffness="8" damping="2"/>
        <contact solref="0.02 1" solimp="0.8 0.95 0.01" condim="3" friction="0.9 0.02 0.01"/>
      </flexcomp>

      <!-- Head: short elastic strands centered above the torso. -->
      <flexcomp name="head_front" type="grid" count="5 1 1" dim="1" pos="0 -0.025 0.25" spacing="0.02 0.02 0.02" radius="0.006" mass="0.018" material="doll_skin">
        <edge stiffness="6" damping="1.8"/>
        <contact solref="0.02 1" solimp="0.8 0.95 0.01" condim="3" friction="0.8 0.02 0.01"/>
      </flexcomp>
      <flexcomp name="head_back" type="grid" count="5 1 1" dim="1" pos="0 0.025 0.25" spacing="0.02 0.02 0.02" radius="0.006" mass="0.018" material="doll_skin">
        <edge stiffness="6" damping="1.8"/>
        <contact solref="0.02 1" solimp="0.8 0.95 0.01" condim="3" friction="0.8 0.02 0.01"/>
      </flexcomp>

      <!-- Arms extend outward from the torso. -->
      <flexcomp name="arm_left_front" type="grid" count="5 1 1" dim="1" pos="-0.11 -0.025 0.16" spacing="0.025 0.025 0.025" radius="0.006" mass="0.018" material="doll_skin">
        <edge stiffness="5" damping="1.6"/>
        <contact solref="0.02 1" solimp="0.8 0.95 0.01" condim="3" friction="0.8 0.02 0.01"/>
      </flexcomp>
      <flexcomp name="arm_left_back" type="grid" count="5 1 1" dim="1" pos="-0.11 0.025 0.16" spacing="0.025 0.025 0.025" radius="0.006" mass="0.018" material="doll_skin">
        <edge stiffness="5" damping="1.6"/>
        <contact solref="0.02 1" solimp="0.8 0.95 0.01" condim="3" friction="0.8 0.02 0.01"/>
      </flexcomp>
      <flexcomp name="arm_right_front" type="grid" count="5 1 1" dim="1" pos="0.11 -0.025 0.16" spacing="0.025 0.025 0.025" radius="0.006" mass="0.018" material="doll_skin">
        <edge stiffness="5" damping="1.6"/>
        <contact solref="0.02 1" solimp="0.8 0.95 0.01" condim="3" friction="0.8 0.02 0.01"/>
      </flexcomp>
      <flexcomp name="arm_right_back" type="grid" count="5 1 1" dim="1" pos="0.11 0.025 0.16" spacing="0.025 0.025 0.025" radius="0.006" mass="0.018" material="doll_skin">
        <edge stiffness="5" damping="1.6"/>
        <contact solref="0.02 1" solimp="0.8 0.95 0.01" condim="3" friction="0.8 0.02 0.01"/>
      </flexcomp>

      <!-- Legs are vertical strands rotated from the grid's x-axis. -->
      <flexcomp name="leg_left_front" type="grid" count="5 1 1" dim="1" pos="-0.035 -0.022 0.07" quat="0.7071068 0 0.7071068 0" spacing="0.025 0.025 0.025" radius="0.006" mass="0.022" material="doll_skin">
        <edge stiffness="7" damping="2"/>
        <contact solref="0.02 1" solimp="0.8 0.95 0.01" condim="3" friction="0.9 0.02 0.01"/>
      </flexcomp>
      <flexcomp name="leg_right_front" type="grid" count="5 1 1" dim="1" pos="0.035 -0.022 0.07" quat="0.7071068 0 0.7071068 0" spacing="0.025 0.025 0.025" radius="0.006" mass="0.022" material="doll_skin">
        <edge stiffness="7" damping="2"/>
        <contact solref="0.02 1" solimp="0.8 0.95 0.01" condim="3" friction="0.9 0.02 0.01"/>
      </flexcomp>
      <flexcomp name="leg_left_back" type="grid" count="5 1 1" dim="1" pos="-0.035 0.022 0.07" quat="0.7071068 0 0.7071068 0" spacing="0.025 0.025 0.025" radius="0.006" mass="0.022" material="doll_skin">
        <edge stiffness="7" damping="2"/>
        <contact solref="0.02 1" solimp="0.8 0.95 0.01" condim="3" friction="0.9 0.02 0.01"/>
      </flexcomp>
      <flexcomp name="leg_right_back" type="grid" count="5 1 1" dim="1" pos="0.035 0.022 0.07" quat="0.7071068 0 0.7071068 0" spacing="0.025 0.025 0.025" radius="0.006" mass="0.022" material="doll_skin">
        <edge stiffness="7" damping="2"/>
        <contact solref="0.02 1" solimp="0.8 0.95 0.01" condim="3" friction="0.9 0.02 0.01"/>
      </flexcomp>
    </body>
  </worldbody>
</mujoco>
