<mujoco model="world">
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <headlight ambient="0.25 0.25 0.25" diffuse="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <quality shadowsize="2048"/>
    <global offwidth="1280" offheight="1280"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.6 0.7 0.9" rgb2="0.1 0.1 0.2" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.7 0.7 0.7" rgb2="0.5 0.5 0.5" width="300" height="300"/>
    <material name="grid_mat" texture="grid" texrepeat="5 5" reflectance="0.1" shininess="0.1"/>
  </asset>

  <worldbody>
    <!-- key light: main directional light, casts shadows -->
    <light name="key" pos="0.6 -0.6 1.2" dir="-0.5 0.5 -1" directional="true"
           diffuse="0.7 0.7 0.65" specular="0.3 0.3 0.3" castshadow="true"/>
    <!-- fill light: softer, opposite side, no shadow so it doesn't double-darken -->
    <light name="fill" pos="-0.7 0.5 0.8" dir="0.7 -0.5 -0.6" directional="true"
           diffuse="0.25 0.25 0.3" castshadow="false"/>
    <!-- rim/back light: separates object from background -->
    <light name="rim" pos="0 0.8 0.5" dir="0 -0.8 -0.3" directional="true"
           diffuse="0.2 0.2 0.22" castshadow="false"/>

    <geom name="floor" type="plane" size="1 1 0.1" material="grid_mat"/>

    <!-- three RGB-D views around the origin -->
    <body name="cam_front_target" pos="0.0 0.0 0.05"/>
    <body name="cam_side_target" pos="0.0 0.0 0.05"/>
    <body name="cam_top_target" pos="0.0 0.0 0.05"/>

    <camera name="cam_front" pos="0.0 -0.6 0.4" mode="targetbody" target="cam_front_target"/>
    <camera name="cam_side" pos="0.6 0.0 0.4" mode="targetbody" target="cam_side_target"/>
    <camera name="cam_top" pos="0.0 0.0 0.8" mode="targetbody" target="cam_top_target"/>
  </worldbody>
</mujoco>
