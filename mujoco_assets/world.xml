<mujoco model="world">
  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81"/>

  <visual>
    <headlight ambient="0.42 0.42 0.42" diffuse="0.45 0.45 0.45" specular="0.12 0.12 0.12"/>
    <quality shadowsize="2048"/>
    <global offwidth="1280" offheight="1280"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.6 0.7 0.9" rgb2="0.1 0.1 0.2" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.58 0.60 0.63" rgb2="0.40 0.42 0.45" width="300" height="300"/>
    <material name="grid_mat" texture="grid" texrepeat="5 5" reflectance="0.04" shininess="0.18"/>
  </asset>

  <worldbody>
    <!-- key light: main directional light, casts shadows -->
    <light name="key" pos="0.6 -0.8 1.3" dir="-0.35 0.55 -1" directional="true"
           diffuse="0.48 0.48 0.45" specular="0.16 0.16 0.16" castshadow="true"/>
    <!-- Broad fill light lifts shadowed sides without creating a second shadow. -->
    <light name="fill" pos="-0.8 -0.2 1.0" dir="0.55 0.15 -1" directional="true"
           diffuse="0.38 0.40 0.46" specular="0.05 0.05 0.06" castshadow="false"/>
    <!-- Soft opposite-side light preserves shape separation from the floor. -->
    <light name="rim" pos="0.2 0.9 1.0" dir="-0.1 -0.7 -1" directional="true"
           diffuse="0.30 0.32 0.38" specular="0.08 0.08 0.10" castshadow="false"/>
    <!-- Low-power front fill keeps contact faces readable during pushing. -->
    <light name="front_fill" pos="0 -0.9 0.7" dir="0 0.4 -1" directional="true"
           diffuse="0.18 0.20 0.22" castshadow="false"/>

    <geom name="floor" type="plane" size="1 1 0.1" material="grid_mat"/>

    <!-- three RGB-D views around the origin -->
    <body name="cam_front_target" pos="0.0 0.0 0.14"/>
    <body name="cam_side_target" pos="0.0 0.0 0.14"/>
    <body name="cam_opposite_target" pos="0.0 0.0 0.14"/>

    <!-- PhysTwin-style horizontal views: straight-on, side-oblique, and the
         opposite side. There is intentionally no top-down camera. -->
    <camera name="cam_front" pos="0.0 -1.00 0.26" mode="targetbody" target="cam_front_target"/>
    <camera name="cam_side" pos="0.95 0.16 0.30" mode="targetbody" target="cam_side_target"/>
    <camera name="cam_opposite" pos="-0.95 0.16 0.30" mode="targetbody" target="cam_opposite_target"/>
  </worldbody>
</mujoco>
