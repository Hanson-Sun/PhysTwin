<mujoco model="world">
  <!-- MJCF defaults this to "degree", which silently turned every angle in
       the scene into degrees: claw.xml writes range="-0.8 0.8" and
       ctrlrange="-0.8 0.8" in radians, and they compiled to +-0.8 DEGREES,
       freezing the finger hinges at +-0.01396 rad. Every angle in the assets
       is authored in radians, so pin the unit here. This file is included
       exactly once per scene (see scene.build_scene), so it is the only place
       a <compiler> element can live. -->
  <compiler angle="radian"/>

  <!-- cone=elliptic + impratio=10: the default pyramidal cone resolves
       friction poorly, which shows up as gripper contacts that transmit
       almost no tangential load (MuJoCo's own guidance for grasping). -->
  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81"
          cone="elliptic" impratio="10"/>

  <visual>
    <headlight ambient="0.42 0.42 0.42" diffuse="0.45 0.45 0.45" specular="0.12 0.12 0.12"/>
    <quality shadowsize="2048"/>
    <global offwidth="1280" offheight="1280"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.6 0.7 0.9" rgb2="0.1 0.1 0.2" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.58 0.60 0.63" rgb2="0.40 0.42 0.45" width="300" height="300"/>
    <material name="grid_mat" texture="grid" texrepeat="5 5" reflectance="0.04" shininess="0.18"/>
  </asset>

  <worldbody>
    <!-- key light: main directional light, casts shadows -->
    <light name="key" pos="0.6 -0.8 1.3" dir="-0.35 0.55 -1" directional="true"
           diffuse="0.48 0.48 0.45" specular="0.16 0.16 0.16" castshadow="true"/>
    <!-- Broad fill light lifts shadowed sides without creating a second shadow. -->
    <light name="fill" pos="-0.8 -0.2 1.0" dir="0.55 0.15 -1" directional="true"
           diffuse="0.38 0.40 0.46" specular="0.05 0.05 0.06" castshadow="false"/>
    <!-- Soft opposite-side light preserves shape separation from the floor. -->
    <light name="rim" pos="0.2 0.9 1.0" dir="-0.1 -0.7 -1" directional="true"
           diffuse="0.30 0.32 0.38" specular="0.08 0.08 0.10" castshadow="false"/>
    <!-- Low-power front fill keeps contact faces readable during pushing. -->
    <light name="front_fill" pos="0 -0.9 0.7" dir="0 0.4 -1" directional="true"
           diffuse="0.18 0.20 0.22" castshadow="false"/>

    <!-- solref tightened from the default: a 0.2 kg box used to settle
         centimetres into the floor at rest. -->
    <geom name="floor" type="plane" size="1 1 0.1" friction="0.15 0.005 0.0001"
          solref="0.005 1" material="grid_mat"/>

    <!-- three RGB-D views around the origin -->
    <body name="cam_front_target" pos="0.0 0.0 0.14"/>
    <body name="cam_side_target" pos="0.0 0.0 0.14"/>
    <body name="cam_opposite_target" pos="0.0 0.0 0.14"/>

    <!-- Three raised, downward-looking views around the origin: straight-on,
         side-oblique, and the opposite side. All three sit at z=0.52 and aim at
         their *_target body at z=0.14 (the upper body of the object), so each
         looks ~20 degrees down instead of the ~7-9 degrees of the original
         level rig. The extra top-surface coverage is what the TRELLIS shape
         prior wants, and keeping the three heights equal preserves the
         symmetric triangulation the multi-view merge depends on. There is
         still no dedicated top-down camera. -->
    <camera name="cam_front" pos="0.0 -1.00 0.52" mode="targetbody" target="cam_front_target"/>
    <camera name="cam_side" pos="0.95 0.16 0.52" mode="targetbody" target="cam_side_target"/>
    <camera name="cam_opposite" pos="-0.95 0.16 0.52" mode="targetbody" target="cam_opposite_target"/>
  </worldbody>
</mujoco>
