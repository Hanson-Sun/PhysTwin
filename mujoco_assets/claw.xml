<mujoco model="claw">
  <!-- A visually distinctive two-prong claw. The mocap origin remains the
       pinch point so existing interaction trajectories stay compatible. -->
  <worldbody>
    <body name="__NAME__" mocap="true" pos="0 0 0.3">
      <!-- Large colored pads make the contact point easy to segment. -->
      <geom name="__NAME___pad_l" type="sphere" pos="-0.016 0 0" size="0.012"
            material="claw_pad" solref="0.01 1" contype="1" conaffinity="1"/>
      <geom name="__NAME___pad_r" type="sphere" pos="0.016 0 0" size="0.012"
            material="claw_pad" solref="0.01 1" contype="1" conaffinity="1"/>

      <!-- Splayed prongs provide a recognizable claw silhouette. -->
      <geom name="__NAME___finger_l" type="capsule"
            fromto="-0.016 0 0 -0.048 0 0.13" size="0.009"
            material="claw_metal" solref="0.01 1" contype="1" conaffinity="1"/>
      <geom name="__NAME___finger_r" type="capsule"
            fromto="0.016 0 0 0.048 0 0.13" size="0.009"
            material="claw_metal" solref="0.01 1" contype="1" conaffinity="1"/>
      <geom name="__NAME___tip_l" type="capsule"
            fromto="-0.048 0 0.13 -0.035 0 0.16" size="0.010"
            material="claw_metal" solref="0.01 1" contype="1" conaffinity="1"/>
      <geom name="__NAME___tip_r" type="capsule"
            fromto="0.048 0 0.13 0.035 0 0.16" size="0.010"
            material="claw_metal" solref="0.01 1" contype="1" conaffinity="1"/>

      <!-- Palm and thick wrist make the tool readable in RGB frames. -->
      <geom name="__NAME___palm" type="box" pos="0 0 0.17"
            size="0.065 0.035 0.022" material="claw_metal"
            contype="1" conaffinity="1"/>
      <geom name="__NAME___housing" type="box" pos="0 0 0.215"
            size="0.045 0.030 0.025" material="claw_metal"
            contype="1" conaffinity="1"/>
      <geom name="__NAME___wrist" type="capsule"
            fromto="0 0 0.23 0 0 0.34" size="0.022"
            material="claw_metal" contype="1" conaffinity="1"/>
      <geom name="__NAME___wrist_cap" type="sphere" pos="0 0 0.35"
            size="0.028" material="claw_pad" contype="1" conaffinity="1"/>
    </body>
  </worldbody>
</mujoco>
