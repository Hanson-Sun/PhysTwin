<mujoco model="claw">
  <!--
    Mocap-driven two-finger claw. Kinematic (mocap) so it can be scripted
    directly via pos/quat each step, while still producing real contacts
    with objects. The local origin (0,0,0) is the pinch point / contact
    point that DigitalTwinSim.set_interactor_pose places at the target.

    Fingers stay nearly parallel to the push/poke axis (only a slight
    taper) so they don't sweep diagonally through an object's side during
    a horizontal push -- a splayed "V" shape looks more claw-like but
    clips through anything taller than the pinch point, since the fingers
    cross the object's height range at an angle. Palm/wrist sit well back
    (from local z=0.10) so they clear objects roughly the size of the
    default box.

    __NAME__ is a placeholder substituted by scene.py for each instance
    (e.g. "interactor0", "interactor1", ...) so multiple claws can be
    composed into one scene without name collisions. Materials live in
    claw_materials.xml (included once, separately) rather than here, since
    this body file may be included more than once for multiple claws and
    MJCF doesn't allow duplicate asset names.
  -->
  <worldbody>
    <body name="__NAME__" mocap="true" pos="0 0 0.3">
      <geom name="__NAME___pad_l" type="sphere" pos="-0.005 0 0" size="0.007"
            material="claw_pad" solref="0.004 1" contype="1" conaffinity="1"/>
      <geom name="__NAME___pad_r" type="sphere" pos="0.005 0 0" size="0.007"
            material="claw_pad" solref="0.004 1" contype="1" conaffinity="1"/>
      <geom name="__NAME___finger_l" type="capsule" fromto="-0.005 0 0 -0.010 0 0.10" size="0.005"
            material="claw_metal" solref="0.004 1" contype="1" conaffinity="1"/>
      <geom name="__NAME___finger_r" type="capsule" fromto="0.005 0 0 0.010 0 0.10" size="0.005"
            material="claw_metal" solref="0.004 1" contype="1" conaffinity="1"/>
      <geom name="__NAME___palm" type="box" pos="0 0 0.115" size="0.018 0.014 0.010"
            material="claw_metal" contype="1" conaffinity="1"/>
      <geom name="__NAME___wrist" type="capsule" fromto="0 0 0.13 0 0 0.19" size="0.010"
            material="claw_metal" contype="1" conaffinity="1"/>
    </body>
  </worldbody>
</mujoco>
