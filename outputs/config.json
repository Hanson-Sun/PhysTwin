{
  "model": {
    "T": 16,
    "base_channels": 32,
    "rgb_encoder_channels": 16,
    "depth_encoder_channels": 16
  },
  "training": {
    "batch_size": 4,
    "learning_rate": 0.001,
    "num_epochs": 50,
    "weight_decay": 0.0001,
    "lambda_temporal": 1.0,
    "lambda_geometric": 0.5,
    "lambda_smooth": 0.3,
    "motion_threshold": 0.05,
    "log_interval": 10
  },
  "data": {
    "background_stddev_threshold": 0.01,
    "depth_std_clamp": 1e-06
  }
}